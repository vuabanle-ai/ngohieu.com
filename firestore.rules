rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bộ đếm truy cập ẩn danh: mỗi ngày một bản ghi stats/YYYY-MM-DD, chỉ chứa các con số tổng hợp.
    match /stats/{day} {
      allow read: if true;
      allow create, update: if day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['views', 'visitors', 'newV', 'returning', 'units', 'pages', 'src']);
    }
  }
}
