rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Quản trị: chỉ tài khoản có UID trong danh sách này (tài khoản 0914 669 669 của anh Hiếu) mới xem được báo cáo.
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['CHUA_CO_ADMIN'];
    }
    function signedIn() {
      return request.auth != null && request.auth.token.email is string && request.auth.token.email.matches('^[0-9]+@u[.]ngohieu[.]com$');
    }
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid;
    }
    match /events/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }
  }
}
