rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chỉ tài khoản đã xác thực OTP số điện thoại mới có phone_number trong token
    function verified() {
      return request.auth != null && request.auth.token.phone_number is string;
    }
    function isAdmin() {
      return verified() && request.auth.token.phone_number == '+84914669669';
    }
    match /users/{uid} {
      allow read: if isAdmin() || (verified() && request.auth.uid == uid);
      allow create, update: if verified() && request.auth.uid == uid;
    }
    match /events/{id} {
      allow create: if verified() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }
  }
}
